# The crate in rust/, built by cargo as a shared library and installed as libtvm_tirx_rust next to
# libtvm_tirx_compiler. `import tvm_tirx` loads it after the compiler library and registers the
# operators it defines (python/tvm_tirx/base.py), as loading the compiler registers the C++ ones.
#
# TVM_TIRX_USE_RUST is ON, OFF or AUTO. AUTO builds the library when it can: not on Windows, with
# the crate's sources (a source distribution has none), with a cargo at least as new as the
# crate's rust-version, and with the crate's dependencies, which `cargo fetch` gets from crates.io
# or finds in cargo's cache. rustup's cargo ($CARGO_HOME/bin or ~/.cargo/bin) is preferred over one
# on PATH, which may be an older system cargo; set TVM_TIRX_CARGO to choose another.
#
# A build without the library removes the one an earlier build left, which `import tvm_tirx` would
# load otherwise.
set(_rust_old_lib "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}/${CMAKE_SHARED_LIBRARY_PREFIX}tvm_tirx_rust${CMAKE_SHARED_LIBRARY_SUFFIX}")
if("${TVM_TIRX_USE_RUST}" MATCHES ${IS_FALSE_PATTERN})
  file(REMOVE "${_rust_old_lib}")
  return()
endif()
set(_rust_manifest "${CMAKE_CURRENT_SOURCE_DIR}/rust/Cargo.toml")
set(_rust_problem "")
if(WIN32)
  set(_rust_problem "it is not supported on Windows yet")
elseif(NOT EXISTS "${_rust_manifest}")
  set(_rust_problem "${_rust_manifest} does not exist")
else()
  file(STRINGS "${_rust_manifest}" _rust_version REGEX "^rust-version *=")
  string(REGEX REPLACE "^rust-version *= *\"([0-9.]+)\".*$" "\\1" _rust_version "${_rust_version}")
  set(_cargo_hints "$ENV{HOME}/.cargo/bin")
  if(DEFINED ENV{CARGO_HOME})
    list(PREPEND _cargo_hints "$ENV{CARGO_HOME}/bin")
  endif()
  find_program(TVM_TIRX_CARGO cargo HINTS ${_cargo_hints})
  if(NOT TVM_TIRX_CARGO)
    set(_rust_problem "cargo was not found")
  else()
    execute_process(COMMAND "${TVM_TIRX_CARGO}" --version OUTPUT_VARIABLE _cargo_version
      ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" _cargo_version "${_cargo_version}")
    if(NOT _cargo_version OR _cargo_version VERSION_LESS _rust_version)
      set(_rust_problem
        "${TVM_TIRX_CARGO} is version ${_cargo_version}, older than the ${_rust_version} rust/ needs")
    else()
      execute_process(COMMAND "${TVM_TIRX_CARGO}" fetch --manifest-path "${_rust_manifest}"
        RESULT_VARIABLE _cargo_fetch OUTPUT_QUIET ERROR_VARIABLE _cargo_fetch_error TIMEOUT 300)
      if(NOT _cargo_fetch EQUAL 0)
        string(REGEX MATCH "error: [^\n]*" _cargo_fetch_error "${_cargo_fetch_error}")
        set(_rust_problem "`cargo fetch` cannot get the crate's dependencies (${_cargo_fetch_error})")
      endif()
    endif()
  endif()
endif()
if(_rust_problem)
  if(NOT "${TVM_TIRX_USE_RUST}" MATCHES "^[Aa][Uu][Tt][Oo]$")
    message(FATAL_ERROR "TVM_TIRX_USE_RUST is ON, but ${_rust_problem}")
  endif()
  message(STATUS "Rust AUTO: ${_rust_problem}; building without libtvm_tirx_rust")
  file(REMOVE "${_rust_old_lib}")
  return()
endif()
message(STATUS "Build libtvm_tirx_rust with ${TVM_TIRX_CARGO} ${_cargo_version}")
set(_rust_dir "${CMAKE_CURRENT_BINARY_DIR}/rust")
# The build scripts of tvm-tirx and tvm-ffi-sys link the libraries in the directories that
# `tvm-tirx-config --libdir` and `tvm-ffi-config --libdir` print: answer with this build's.
foreach(_tool_target tvm-tirx-config:tvm_tirx_compiler tvm-ffi-config:tvm_ffi_shared)
  string(REPLACE ":" ";" _tool_target "${_tool_target}")
  list(GET _tool_target 0 _tool)
  list(GET _tool_target 1 _target)
  file(GENERATE OUTPUT "${_rust_dir}/bin/${_tool}"
    CONTENT "#!/bin/sh\n# ${_tool} for the cargo build of rust/, generated by CMake.\n\
[ \"$1\" = --libdir ] || { echo \"${_tool}: only --libdir is supported here\" >&2; exit 1; }\n\
echo \"$<TARGET_FILE_DIR:${_target}>\"\n"
    FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE
      WORLD_READ WORLD_EXECUTE)
endforeach()
if(CMAKE_BUILD_TYPE STREQUAL "Debug")
  set(_rust_profile debug)
  set(_rust_profile_args)
else()
  set(_rust_profile release)
  set(_rust_profile_args --release)
endif()
set(_rust_built "${_rust_dir}/target/${_rust_profile}/${CMAKE_SHARED_LIBRARY_PREFIX}tvm_tirx${CMAKE_SHARED_LIBRARY_SUFFIX}")
set(_rust_lib "$<TARGET_FILE_DIR:tvm_tirx_compiler>/${CMAKE_SHARED_LIBRARY_PREFIX}tvm_tirx_rust${CMAKE_SHARED_LIBRARY_SUFFIX}")
# Cargo decides what to rebuild, so the target always runs it.
add_custom_target(tvm_tirx_rust ALL
  COMMAND "${CMAKE_COMMAND}" -E env "PATH=${_rust_dir}/bin:$ENV{PATH}"
    "CARGO_TARGET_DIR=${_rust_dir}/target"
    "${TVM_TIRX_CARGO}" build --lib ${_rust_profile_args}
    --manifest-path "${_rust_manifest}"
  COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_rust_built}" "${_rust_lib}"
  COMMENT "Building libtvm_tirx_rust with cargo"
  USES_TERMINAL VERBATIM)
add_dependencies(tvm_tirx_rust tvm_tirx_compiler tvm_ffi_shared)
install(FILES "${_rust_lib}" DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT tvm_tirx)
